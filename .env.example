# Server
PORT=8080
HOST=0.0.0.0

# Tool Loop
MAX_TOOL_LOOPS=8
TOOL_TIMEOUT_MS=15000

# Workspace
WORKSPACE_DIR=/workspace

# OpenAI (for RAG embeddings)
OPENAI_API_KEY=sk-your-api-key-here

# Qdrant (optional - for RAG)
QDRANT_HOST=http://localhost:6333
QDRANT_COLLECTION=codex-rag

# Auth (optional - for OpenAI API calls)
AUTH_FILE=/app/auth.json
