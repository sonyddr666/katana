# Server
HOST=0.0.0.0
PORT=8080
NODE_ENV=development

# Logger (Pino)
# LOG_LEVEL=info  # fatal | error | warn | info | debug | trace | silent

# Rate limiting (aplicado a todas as rotas exceto /health e /stream)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Tool loop
MAX_TOOL_LOOPS=8
TOOL_TIMEOUT_MS=15000

# Workspace & local data
WORKSPACE_DIR=./workspace
DATA_DIR=./.data
CHATS_DIR=./.data/chats
UPLOADS_DIR=./.data/uploads
AUTH_POOL_DIR=./.data/auth-pool
STORE_STATE_FILE=./.data/store-state.json
ADMIN_PIN=

# Codex web backend
CODEX_RESPONSES_URL=https://chatgpt.com/backend-api/codex/responses
CODEX_REFRESH_URL=https://chatgpt.com/api/auth/session
DEFAULT_CODEX_MODEL=gpt-5.4-mini
AVAILABLE_MODELS=gpt-5.4,gpt-5.4-mini,gpt-5.3-codex,gpt-5.2-codex,gpt-5.2,gpt-5.1-codex-max,gpt-5.1-codex-mini

# Optional RAG / Qdrant metadata
QDRANT_HOST=
QDRANT_COLLECTION=codex-rag

# Codex auth (use auth.json from chatgpt.com session or AUTH_JSON env)
AUTH_FILE=./auth.json
AUTH_JSON=
